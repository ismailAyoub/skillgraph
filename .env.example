# Only needed for `skillgraph ai *`, `skillgraph eval *` and `skillgraph publish`.
# The web editor never reads this: users paste their own key in Settings (kept in the browser).
ANTHROPIC_API_KEY=

# Accounts + cloud save (optional; the app is local-first without them). Public values, RLS guards the data.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
