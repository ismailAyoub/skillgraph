{
  "name": "@skillgraph/ai",
  "version": "0.1.0",
  "description": "AI assistance for SkillGraph: critique, description composer, node copilot, interview-to-graph, transcript-to-skill. Every result is a GraphPatch proposal.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./claude-cli": {
      "types": "./src/claude-cli.ts",
      "default": "./src/claude-cli.ts"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsdown src/index.ts src/claude-cli.ts --format esm --out-dir dist --dts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@skillgraph/core": "workspace:*",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  }
}
